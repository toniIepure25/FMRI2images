{
  "metric_version": "prox-metric/1.0.0",
  "n": 13,
  "metrics": {
    "subspace_overlap": {
      "name": "subspace_overlap",
      "family": "GEOMETRY",
      "question": "How aligned are two subspaces?",
      "definition": "mean squared principal cosine",
      "range": "[0,1]",
      "direction": "higher_better",
      "null_interpretation": "0 under random rank-matched subspaces; 1 identical",
      "failure_modes": "collapses to trivial if either subspace is full-rank",
      "invariances": "orthogonal-basis invariant; symmetric",
      "min_sample": "k+1 samples per subspace",
      "participant_aggregation": "median over participants",
      "allowed_use": "compare two representational subspaces",
      "forbidden_interpretation": "do NOT read as biological similarity",
      "version": "prox-metric/1.0.0"
    },
    "grassmann_distance": {
      "name": "grassmann_distance",
      "family": "GEOMETRY",
      "question": "How far apart are two subspaces?",
      "definition": "sqrt sum of squared principal angles",
      "range": "[0, inf)",
      "direction": "lower_better",
      "null_interpretation": "large under random subspaces",
      "failure_modes": "unstable if ranks differ",
      "invariances": "orthogonal-basis invariant",
      "min_sample": "k+1 samples",
      "participant_aggregation": "median",
      "allowed_use": "subspace distance",
      "forbidden_interpretation": "not a distance in neural space",
      "version": "prox-metric/1.0.0"
    },
    "chordal_distance": {
      "name": "chordal_distance",
      "family": "GEOMETRY",
      "question": "Projector chordal distance",
      "definition": "sqrt sum sin^2 principal angles",
      "range": "[0, sqrt k]",
      "direction": "lower_better",
      "null_interpretation": "large under random",
      "failure_modes": "rank-sensitive",
      "invariances": "orthogonal-basis invariant",
      "min_sample": "k+1",
      "participant_aggregation": "median",
      "allowed_use": "subspace distance",
      "forbidden_interpretation": "not neural distance",
      "version": "prox-metric/1.0.0"
    },
    "projector_frobenius": {
      "name": "projector_frobenius",
      "family": "GEOMETRY",
      "question": "Projector Frobenius distance",
      "definition": "||P_A - P_B||_F",
      "range": "[0, sqrt(2k)]",
      "direction": "lower_better",
      "null_interpretation": "large under random",
      "failure_modes": "rank-sensitive",
      "invariances": "orthogonal-basis invariant",
      "min_sample": "k+1",
      "participant_aggregation": "median",
      "allowed_use": "projector distance",
      "forbidden_interpretation": "not neural distance",
      "version": "prox-metric/1.0.0"
    },
    "pattern_correlation": {
      "name": "pattern_correlation",
      "family": "PREDICTION",
      "question": "Held-out pattern correlation",
      "definition": "Pearson r of vectorized patterns",
      "range": "[-1,1]",
      "direction": "higher_better",
      "null_interpretation": "0 under permuted labels",
      "failure_modes": "inflated by low-dim structure; sensitive to outliers",
      "invariances": "invariant to global scale/shift",
      "min_sample": ">=3 participants for inference",
      "participant_aggregation": "median + sign-flip",
      "allowed_use": "predicted vs actual pattern",
      "forbidden_interpretation": "not R^2; not causal",
      "version": "prox-metric/1.0.0"
    },
    "cosine_similarity": {
      "name": "cosine_similarity",
      "family": "PREDICTION",
      "question": "Directional alignment",
      "definition": "|cos| of vectors",
      "range": "[0,1]",
      "direction": "higher_better",
      "null_interpretation": "~0 under random",
      "failure_modes": "magnitude-insensitive",
      "invariances": "scale invariant",
      "min_sample": ">=3",
      "participant_aggregation": "median + sign-flip",
      "allowed_use": "direction alignment",
      "forbidden_interpretation": "not magnitude match",
      "version": "prox-metric/1.0.0"
    },
    "support_fraction": {
      "name": "support_fraction",
      "family": "SUPPORT",
      "question": "Fraction of target energy within perception support",
      "definition": "within_energy / total_energy",
      "range": "[0,1]",
      "direction": "context",
      "null_interpretation": "n/a (descriptive)",
      "failure_modes": "depends on frozen support basis",
      "invariances": "invariant to within-support rotation",
      "min_sample": "1 target",
      "participant_aggregation": "median",
      "allowed_use": "quantify perception-explained energy",
      "forbidden_interpretation": "not proof perception determines imagery",
      "version": "prox-metric/1.0.0"
    },
    "outside_support_residual": {
      "name": "outside_support_residual",
      "family": "SUPPORT",
      "question": "Fraction outside perception support",
      "definition": "1 - support_fraction",
      "range": "[0,1]",
      "direction": "context",
      "null_interpretation": "n/a",
      "failure_modes": "representation-dependent",
