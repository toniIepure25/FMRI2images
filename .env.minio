# =============================================================================
# Environment configuration for MinIO/S3 backend
# =============================================================================
# This file shows how to configure the project to use MinIO object storage
# instead of downloading the full NSD dataset locally.
#
# Copy this to .env and customize for your MinIO setup:
#   cp .env.minio .env
#
# Then add your MinIO credentials and test the connection.
# =============================================================================

# User identifier (replace with your actual username)
USER=${USER:-student01}

# Project root (auto-detected by scripts, but can override)
# PROJECT_ROOT=/bigdata/userhome/students/${USER}/Bachelor_V2

# =============================================================================
# MinIO/S3 Configuration - CUSTOMIZE THESE!
# =============================================================================

# MinIO endpoint (ask your technician)
AWS_ENDPOINT_URL=https://ubbc1u.ro:9000

# MinIO credentials (get from technician)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Required by boto3/s3fs but not used by MinIO
AWS_DEFAULT_REGION=us-east-1

# If MinIO uses self-signed certificate, uncomment:
# AWS_NO_VERIFY_SSL=1

# Allow S3-only mode (no local NSD data required)
ALLOW_S3_ONLY=1

# MinIO bucket and paths (adjust based on your MinIO setup)
MINIO_BUCKET=nsd-data
NSD_S3_ROOT=s3://${MINIO_BUCKET}/nsddata/
NSD_S3_BETAS=s3://${MINIO_BUCKET}/nsddata_betas/
NSD_S3_STIMULI=s3://${MINIO_BUCKET}/nsddata_stimuli/

# =============================================================================
# Data Directories
# =============================================================================

# Local directories (for small files that aren't on MinIO)
DATA_DIR=/bigdata/userhome/students/${USER}/data
# Note: NSD_DATA_ROOT not set because we're using S3

# Local cache for S3 downloads (adjust size based on available disk)
# This will cache files as they're accessed from MinIO
S3_CACHE_DIR=/bigdata/userhome/students/${USER}/.cache/s3_cache
CACHE_DIR=/bigdata/userhome/students/${USER}/.cache
CACHE_ROOT=${CACHE_DIR}

# Output and runs directory
RUNS_DIR=/bigdata/userhome/students/${USER}/runs
OUTPUT_ROOT=${RUNS_DIR}

# Checkpoints directory
CHECKPOINT_ROOT=/bigdata/userhome/students/${USER}/checkpoints

# =============================================================================
# Python Environment
# =============================================================================

VENV_PATH=/bigdata/userhome/students/${USER}/venv
PYTHON_VERSION=3.11.2

# =============================================================================
# CUDA/GPU Settings
# =============================================================================

CUDA_VERSION=12.2
CUDA_VISIBLE_DEVICES=0

# =============================================================================
# Experiment Settings
# =============================================================================

DEFAULT_SEED=42
# Reduce workers for S3/network I/O (prevents too many concurrent requests)
NUM_WORKERS=2

# Logging
LOG_LEVEL=INFO

# =============================================================================
# Advanced Settings
# =============================================================================

# Torch settings for reproducibility
CUBLAS_WORKSPACE_CONFIG=:4096:8
PYTHONHASHSEED=0

# Disable wandb if not needed
WANDB_MODE=disabled

# HuggingFace cache (local)
HF_HOME=${CACHE_DIR}/huggingface
TRANSFORMERS_CACHE=${CACHE_DIR}/transformers

# =============================================================================
# S3/fsspec Settings (Optional)
# =============================================================================

# Cache type for S3 filesystem
# Options: simplecache, blockcache, filecache
S3_CACHE_TYPE=simplecache

# Maximum cache size (prevents unlimited growth)
# Uncomment to enable (in bytes: 50GB = 53687091200)
# S3_CACHE_MAX_SIZE=53687091200

# =============================================================================
# Usage Instructions
# =============================================================================
#
# 1. Copy this file:
#    cp .env.minio .env
#
# 2. Edit .env and set:
#    - USER (your username)
#    - AWS_ENDPOINT_URL (MinIO server URL)
#    - AWS_ACCESS_KEY_ID (from technician)
#    - AWS_SECRET_ACCESS_KEY (from technician)
#    - MINIO_BUCKET (bucket name where NSD data is stored)
#
# 3. Test connection:
#    source activate_env.sh
#    python -c "import s3fs, os; fs = s3fs.S3FileSystem(endpoint_url=os.environ['AWS_ENDPOINT_URL']); print('Buckets:', fs.ls(''))"
#
# 4. Verify data:
#    python scripts/verify_dataset.py --allow-s3-only
#
# 5. Run experiments:
#    bash scripts/run_experiment_simple.sh configs/experiments/your_config.yaml
#
# =============================================================================
