\newlabel{fig:query_surfer}{{5.5a}{37}{Surfer query (NSD\,8262). The two 768-D experts return semantically related but incorrect scenes; V61a-MCTTA16 and the triple fusion both recover the ground truth at rank\,1.\relax }{figure.caption.33}{}}
\newlabel{sub@fig:query_surfer}{{a}{37}{Surfer query (NSD\,8262). The two 768-D experts return semantically related but incorrect scenes; V61a-MCTTA16 and the triple fusion both recover the ground truth at rank\,1.\relax }{figure.caption.33}{}}
\newlabel{fig:query_skier}{{5.5b}{37}{Skier query (NSD\,21279). Both 768-D experts miss the correct stimulus by a wide margin; V61a-MCTTA16 and the triple fusion both recover it at rank\,1.\relax }{figure.caption.33}{}}
\newlabel{sub@fig:query_skier}{{b}{37}{Skier query (NSD\,21279). Both 768-D experts miss the correct stimulus by a wide margin; V61a-MCTTA16 and the triple fusion both recover it at rank\,1.\relax }{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces Qualitative retrieval successes~(I). Each panel shows, from left to right, the ground-truth stimulus (blue border), the top-1 retrievals of the three individual experts, and the triple-fusion top-1 (dark border). Annotations give the rank of the ground truth for each expert (\text  {$\mathsurround \z@ \mathchar "458$}$=$ rank-1, \texttimes \ $=$ miss). The 768-D experts fail with semantically plausible alternatives while the token-space expert with MC-TTA-16 and the fusion recover the exact image at rank~1.\relax }}{37}{figure.caption.33}\protected@file@percent }
\newlabel{fig:retrieval_successes_1}{{5.5}{37}{Qualitative retrieval successes~(I). Each panel shows, from left to right, the ground-truth stimulus (blue border), the top-1 retrievals of the three individual experts, and the triple-fusion top-1 (dark border). Annotations give the rank of the ground truth for each expert (\checkmark $=$ rank-1, \texttimes \ $=$ miss). The 768-D experts fail with semantically plausible alternatives while the token-space expert with MC-TTA-16 and the fusion recover the exact image at rank~1.\relax }{figure.caption.33}{}}
\newlabel{fig:query_seagulls}{{5.6a}{38}{Seagull query (NSD\,55649). V62a returns a related but incorrect bird scene, V66a a more distant miss; V61a-MCTTA16 and the triple fusion both recover the ground truth at rank\,1.\relax }{figure.caption.34}{}}
\newlabel{sub@fig:query_seagulls}{{a}{38}{Seagull query (NSD\,55649). V62a returns a related but incorrect bird scene, V66a a more distant miss; V61a-MCTTA16 and the triple fusion both recover the ground truth at rank\,1.\relax }{figure.caption.34}{}}
\newlabel{fig:query_fruitbowl}{{5.6b}{38}{Fruit-bowl query (NSD\,8509). V61a-MCTTA16, V66a, and the triple fusion all recover the ground truth at rank\,1; V62a narrowly misses at rank\,2. This convergence among experts is characteristic of the easy regime.\relax }{figure.caption.34}{}}
\newlabel{sub@fig:query_fruitbowl}{{b}{38}{Fruit-bowl query (NSD\,8509). V61a-MCTTA16, V66a, and the triple fusion all recover the ground truth at rank\,1; V62a narrowly misses at rank\,2. This convergence among experts is characteristic of the easy regime.\relax }{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces Qualitative retrieval successes~(II). Column order and annotation conventions as in Figure~\ref  {fig:retrieval_successes_1}. The seagull example extends the success pattern of the first figure; the fruit-bowl example shows expert convergence where V66a also retrieves the correct image, with V62a a narrow miss at rank\,2.\relax }}{38}{figure.caption.34}\protected@file@percent }
\newlabel{fig:retrieval_successes_2}{{5.6}{38}{Qualitative retrieval successes~(II). Column order and annotation conventions as in Figure~\ref {fig:retrieval_successes_1}. The seagull example extends the success pattern of the first figure; the fruit-bowl example shows expert convergence where V66a also retrieves the correct image, with V62a a narrow miss at rank\,2.\relax }{figure.caption.34}{}}
