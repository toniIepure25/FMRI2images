\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces Qualitative retrieval successes~(I). Each panel shows, from left to right: ground-truth stimulus, V61a-MCTTA16 top-1, V62a top-1, V66a top-1, and Triple Fusion top-1. The weaker 768-D experts (V62a, V66a) fail with semantically plausible but incorrect alternatives, while V61a-MCTTA16 and the triple fusion both recover the exact image at rank\,1.\relax }}{41}{figure.caption.31}\protected@file@percent }
\newlabel{fig:retrieval_successes_1}{{5.5}{41}{Qualitative retrieval successes~(I). Each panel shows, from left to right: ground-truth stimulus, V61a-MCTTA16 top-1, V62a top-1, V66a top-1, and Triple Fusion top-1. The weaker 768-D experts (V62a, V66a) fail with semantically plausible but incorrect alternatives, while V61a-MCTTA16 and the triple fusion both recover the exact image at rank\,1.\relax }{figure.caption.31}{}}
\newlabel{fig:query_seagulls}{{5.6a}{42}{Seagull query (NSD\,55649). V61a-MCTTA16 retrieves the correct image (rank\,1). V62a misses (rank\,4); V66a misses (rank\,12). The triple fusion recovers the ground truth at rank\,1.\relax }{figure.caption.32}{}}
\newlabel{sub@fig:query_seagulls}{{a}{42}{Seagull query (NSD\,55649). V61a-MCTTA16 retrieves the correct image (rank\,1). V62a misses (rank\,4); V66a misses (rank\,12). The triple fusion recovers the ground truth at rank\,1.\relax }{figure.caption.32}{}}
\newlabel{fig:query_fruitbowl}{{5.6b}{42}{Fruit-bowl query (NSD\,8509). V61a-MCTTA16 and V66a both retrieve the correct image (rank\,1). V62a narrowly misses (rank\,2). The triple fusion recovers the ground truth at rank\,1. This convergence among experts is characteristic of the easy regime.\relax }{figure.caption.32}{}}
\newlabel{sub@fig:query_fruitbowl}{{b}{42}{Fruit-bowl query (NSD\,8509). V61a-MCTTA16 and V66a both retrieve the correct image (rank\,1). V62a narrowly misses (rank\,2). The triple fusion recovers the ground truth at rank\,1. This convergence among experts is characteristic of the easy regime.\relax }{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces Qualitative retrieval successes~(II). Column order as in Figure~\ref  {fig:retrieval_successes_1}: GT, V61a-MCTTA16, V62a, V66a, Triple Fusion. The seagull example extends the success pattern; the fruit-bowl example shows expert convergence where even V66a retrieves the correct image.\relax }}{42}{figure.caption.32}\protected@file@percent }
\newlabel{fig:retrieval_successes_2}{{5.6}{42}{Qualitative retrieval successes~(II). Column order as in Figure~\ref {fig:retrieval_successes_1}: GT, V61a-MCTTA16, V62a, V66a, Triple Fusion. The seagull example extends the success pattern; the fruit-bowl example shows expert convergence where even V66a retrieves the correct image.\relax }{figure.caption.32}{}}
