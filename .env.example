# Copy to .env and edit paths/secrets once.
# This repo uses .env for making runs reproducible on remote GPU pods.
#
# NOTE: Paths should be absolute on remote machines.

# === Core paths ===
# Root folder for NSD / dataset files (raw data). Adjust to your layout.
NSD_DATA_ROOT=/data/nsd
DATASET_ROOT=/data

# Root for generated outputs (runs, reports, reconstructions)
OUTPUT_ROOT=${PWD}/outputs

# Root for caches (preproc, indices, clip embeddings, HF caches)
CACHE_ROOT=${PWD}/cache

# Root for training checkpoints (models you train)
CHECKPOINT_ROOT=${PWD}/checkpoints

# === Hugging Face caches (optional but recommended) ===
# Setting these makes downloads reproducible and avoids polluting ~/.cache on pods.
HF_HOME=${CACHE_ROOT}/hf
TRANSFORMERS_CACHE=${CACHE_ROOT}/hf/transformers
DIFFUSERS_CACHE=${CACHE_ROOT}/hf/diffusers
HF_HUB_CACHE=${CACHE_ROOT}/hf/hub

# Optional token for gated models (leave empty for public models)
HF_TOKEN=

# === Compute/runtime ===
# Device for training/inference: cuda|cpu|mps
DEVICE=cuda

# Optional: force CUDA visible devices (e.g. "0" or "0,1")
CUDA_VISIBLE_DEVICES=

# === Pipeline knobs ===
# Enable diffusion stack requirements (diffusers/transformers/huggingface_hub)
DIFFUSION_ENABLED=1

# Minimum free disk space required by preflight (GB)
PREFLIGHT_MIN_FREE_GB=80

# Subject(s) default
SUBJECT=subj01

# Default diffusion model id (can be overridden per experiment)
# Original stabilityai/stable-diffusion-2-1 was deprecated; use community mirror
DIFFUSION_MODEL_ID=sd2-community/stable-diffusion-2-1
