# =============================================================================
# HYBRID PRODUCTION CONFIGURATION: AWS S3 (NSD) + MinIO (Artifacts)
# =============================================================================
# Optimized for JupyterHub A100 40GB with professional hybrid storage
# =============================================================================

# =============================================================================
# USER CONFIGURATION
# =============================================================================
# IMPORTANT: Replace 'student01' with your actual JupyterHub username
USER=${USER:-student01}

# =============================================================================
# LOCAL PATHS (Server Storage)
# =============================================================================
DATA_DIR=/bigdata/userhome/students/${USER}/data
CACHE_DIR=/bigdata/userhome/students/${USER}/.cache
CHECKPOINT_ROOT=/bigdata/userhome/students/${USER}/checkpoints
RUNS_DIR=/bigdata/userhome/students/${USER}/runs
OUTPUT_ROOT=${RUNS_DIR}

# =============================================================================
# AWS S3 - NSD Dataset (Public, Direct Access)
# =============================================================================
# Use AWS S3 directly for NSD data - NO download needed!
# AWS NSD bucket is public, your code supports direct streaming

# AWS NSD S3 paths (public bucket, no credentials needed)
NSD_S3_ROOT=s3://natural-scenes-dataset/nsddata
NSD_S3_BETAS=s3://natural-scenes-dataset/nsddata_betas
NSD_S3_STIMULI=s3://natural-scenes-dataset/nsddata_stimuli

# Enable S3 streaming
USE_S3_FOR_NSD=true
S3_ANON=true  # Anonymous access for public AWS bucket

# Local cache for S3 downloads (improves repeated access)
S3_CACHE_DIR=${CACHE_DIR}/s3_cache

# =============================================================================
# MinIO - Your Private Artifact Storage
# =============================================================================
# Your MinIO credentials for storing generated artifacts

# MinIO endpoint
AWS_ENDPOINT_URL=https://ubbc1u.ro:9000

# MinIO credentials
AWS_ACCESS_KEY_ID=cjChy0M8fUFIUWJ0SVd9
AWS_SECRET_ACCESS_KEY=TeIDlHx94IJS8ACQPNsmyFqo8IfnKbmzheKYkfxf
AWS_DEFAULT_REGION=us-east-1

# Your private bucket
MINIO_BUCKET=6f628397-de73-4c99-b4b6-51e20859fea2

# MinIO paths for your artifacts
MINIO_CACHE_ROOT=s3://6f628397-de73-4c99-b4b6-51e20859fea2/cache
MINIO_CHECKPOINTS=s3://6f628397-de73-4c99-b4b6-51e20859fea2/checkpoints
MINIO_RESULTS=s3://6f628397-de73-4c99-b4b6-51e20859fea2/results

# Enable MinIO for artifacts
USE_MINIO_FOR_ARTIFACTS=true
ALLOW_S3_ONLY=1

# =============================================================================
# HYBRID DATASET PATHS
# =============================================================================
# Primary data source: AWS S3 (for NSD betas and stimuli)
NSD_DATA_ROOT=${NSD_S3_ROOT}
NSD_BETAS_ROOT=${NSD_S3_BETAS}
NSD_STIMULI_ROOT=${NSD_S3_STIMULI}

# Cache and artifacts: Local first, then MinIO
CACHE_ROOT=${CACHE_DIR}

# =============================================================================
# PYTHON ENVIRONMENT
# =============================================================================
VENV_PATH=${HOME}/Bachelor_V2/venv
PYTHON_VERSION=3.11

# =============================================================================
# GPU/CUDA SETTINGS (A100 40GB Optimized)
# =============================================================================
CUDA_VERSION=12.2
CUDA_VISIBLE_DEVICES=0

# =============================================================================
# DATA LOADING (Optimized for S3 streaming + A100)
# =============================================================================
# Reduced workers for S3 I/O, but still high performance
NUM_WORKERS=16
PREFETCH_FACTOR=2
PERSISTENT_WORKERS=true

# Batch sizes optimized for 40GB VRAM
BATCH_SIZE_RIDGE=512
BATCH_SIZE_MLP=512
BATCH_SIZE_ADAPTER=256
BATCH_SIZE_TWOSTAGE=256

# =============================================================================
# TRAINING SETTINGS
# =============================================================================
DEFAULT_SEED=42
MIXED_PRECISION=true
GRADIENT_CLIP=1.0

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
WANDB_MODE=disabled  # Enable if you want to use Weights & Biases

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================
# Number of CPU threads
NUM_THREADS=40

# Disk space monitoring
MIN_FREE_SPACE_GB=50

# =============================================================================
# NOTES
# =============================================================================
# 1. AWS S3 (NSD): Public bucket, no credentials needed, use directly
# 2. MinIO: Your private storage for caches, checkpoints, results
# 3. Local cache: Stores downloaded S3 files for faster repeated access
# 4. This setup saves ~60GB disk space and 3-4 hours setup time!
#
# To use:
#   1. Replace USER=student01 with your actual username
#   2. source activate_env.sh
#   3. Run experiments - they will stream from AWS S3 automatically
# =============================================================================
