# =============================================================================
# Environment configuration for JupyterHub A100 GPU pod
# =============================================================================
# Source this file or symlink to .env:
#   cp .env.jupyterhub .env && source .env
# =============================================================================

# --- Core paths (assuming repo cloned to /home/jovyan/work/FMRI2images) ---
NSD_DATA_ROOT=/home/jovyan/work/data/nsd
DATASET_ROOT=/home/jovyan/work/data
OUTPUT_ROOT=/home/jovyan/work/FMRI2images/experimental_results
CACHE_ROOT=/home/jovyan/work/FMRI2images/cache
CHECKPOINT_ROOT=/home/jovyan/work/FMRI2images/checkpoints

# --- HuggingFace caches ---
HF_HOME=/home/jovyan/work/.cache/hf
TRANSFORMERS_CACHE=/home/jovyan/work/.cache/hf/transformers
DIFFUSERS_CACHE=/home/jovyan/work/.cache/hf/diffusers
HF_HUB_CACHE=/home/jovyan/work/.cache/hf/hub
HF_TOKEN=

# --- Compute ---
DEVICE=cuda
CUDA_VISIBLE_DEVICES=0

# --- Pipeline ---
DIFFUSION_ENABLED=1
PREFLIGHT_MIN_FREE_GB=80
SUBJECT=subj01
DIFFUSION_MODEL_ID=stabilityai/stable-diffusion-2-1

# --- Reproducibility ---
DEFAULT_SEED=42
NUM_WORKERS=4
CUBLAS_WORKSPACE_CONFIG=:4096:8
PYTHONHASHSEED=0

# --- Logging ---
LOG_LEVEL=INFO
WANDB_MODE=disabled
