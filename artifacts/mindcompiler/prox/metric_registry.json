    "total_recovery": {
      "name": "total_recovery",
      "family": "CALIBRATION",
      "question": "Recovery toward native oracle",
      "definition": "(R-R0)/(R_native-R0)",
      "range": "(-inf,1]",
      "direction": "higher_better",
      "null_interpretation": "0 = baseline; 1 = oracle",
      "failure_modes": "unstable if R_native~R0",
      "invariances": "ratio invariant to affine R shift",
      "min_sample": "1 fold",
      "participant_aggregation": "clip[0,1] then median",
      "allowed_use": "calibration recovery",
      "forbidden_interpretation": "not a universal minimum",
      "version": "prox-metric/1.0.0"
    },
    "full_capacity_fraction": {
      "name": "full_capacity_fraction",
      "family": "CALIBRATION",
      "question": "Recovery toward full-resource ceiling",
      "definition": "(R-R0)/(R111-R0)",
      "range": "(-inf,1]",
      "direction": "higher_better",
      "null_interpretation": "0 baseline; 1 ceiling",
      "failure_modes": "unstable if R111~R0",
      "invariances": "ratio invariant",
      "min_sample": "1 fold",
      "participant_aggregation": "clip[0,1] then median",
      "allowed_use": "capacity fraction",
      "forbidden_interpretation": "estimator-specific",
      "version": "prox-metric/1.0.0"
    },
    "calibration_regret": {
      "name": "calibration_regret",
      "family": "ADAPTIVE",
      "question": "Recovery lost vs oracle stop",
      "definition": "max(0, oracle - achieved)",
      "range": "[0,1]",
      "direction": "lower_better",
      "null_interpretation": "0 = matched oracle",
