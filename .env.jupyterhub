# =============================================================================
# Environment configuration for JupyterHub/HPC deployment
# =============================================================================
# This file should be sourced or symlinked to .env
# Copy this to .env and customize for your environment:
#   cp .env.jupyterhub .env
#
# Then edit the USER variable and any paths as needed.
# =============================================================================

# User identifier (replace with your actual username)
USER=${USER:-student01}

# Project root (auto-detected by scripts, but can override)
# PROJECT_ROOT=/bigdata/userhome/students/${USER}/Bachelor_V2

# Data directories (large files)
# Where NSD dataset lives (betas, stimuli, etc.)
DATA_DIR=/bigdata/userhome/students/${USER}/data
NSD_DATA_ROOT=${DATA_DIR}/nsd

# Output and runs directory
RUNS_DIR=/bigdata/userhome/students/${USER}/runs
OUTPUT_ROOT=${RUNS_DIR}

# Cache directory (embeddings, preprocessed data)
CACHE_DIR=/bigdata/userhome/students/${USER}/.cache
CACHE_ROOT=${CACHE_DIR}

# Checkpoints directory
CHECKPOINT_ROOT=/bigdata/userhome/students/${USER}/checkpoints

# Python environment
VENV_PATH=/bigdata/userhome/students/${USER}/venv
PYTHON_VERSION=3.11.2

# CUDA/GPU settings
CUDA_VERSION=12.2
CUDA_VISIBLE_DEVICES=0

# Experiment settings
DEFAULT_SEED=42
NUM_WORKERS=4

# Logging
LOG_LEVEL=INFO

# =============================================================================
# Advanced settings (usually no need to change)
# =============================================================================

# Torch settings for reproducibility
CUBLAS_WORKSPACE_CONFIG=:4096:8
PYTHONHASHSEED=0

# Disable wandb if not needed
WANDB_MODE=disabled

# HuggingFace cache
HF_HOME=${CACHE_DIR}/huggingface
TRANSFORMERS_CACHE=${CACHE_DIR}/transformers
