  "key_findings": [
    {
      "finding": "Multi-expert agreement is an extraordinarily strong confidence signal",
      "evidence": "At 80% coverage, accuracy rises from 81.2% to 92.2% (+11 pp). At 50%, 97.0%. At 10%, 100%.",
      "significance": "No prior work on neural image decoding studies multi-expert selective prediction",
      "novelty": "HIGH"
    },
    {
      "finding": "vMF kappa significantly predicts decoding quality",
      "evidence": "V62a: ρ(κ, cos_sim) = 0.515, p < 10^-69. Monotonic quintile increase (0.388 → 0.467, +20.4%)",
      "significance": "First demonstration that vMF concentration is informative for neural decoding quality",
      "novelty": "MODERATE"
    },
    {
      "finding": "Agreement captures orthogonal information to single-model kappa",
      "evidence": "Mean kappa is statistically indistinguishable across agreement levels (34.42 vs 34.57)",
      "significance": "The two signals measure different uncertainty aspects (input encoding vs. output stability)",
      "novelty": "HIGH"
    },
    {
      "finding": "Single-model kappa is weaker than margin and MC-Dropout for selective prediction",
      "evidence": "V62a kappa AURC=0.562 vs margin AURC=0.368 vs MC-Dropout AURC=0.429",
      "significance": "Honest negative result: kappa alone is not the best single-model uncertainty measure",
      "novelty": "Important negative finding"
    },
    {
      "finding": "Architectural diversity drives agreement informativeness",
      "evidence": "Pairwise complementarity ranges 34.8-50.9% (different experts make different errors)",
      "significance": "The architectural diversity (MLP vs ROI Transformer, CLS vs token targets) is essential",
      "novelty": "HIGH"
    }
  ],

