\newlabel{tab:experimental_waves}{{5.2}{26}{High-level summary of the major experiment families in the thesis.\relax }{table.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.3}{\ignorespaces Final retrieval results on SHARED1000, reported as Recall@1 with and without CSLS hubness correction. The V30/V32 compact--rerank design stage and the V35 plus N1v28a fixed fusion are retained as methodological milestones, while the final exported system is the frozen cross-architecture triple score fusion with weights $0.7/0.1/0.2$ and CSLS neighbourhood size $k=3$. SHARED1000 CSLS Recall@1 is treated as the primary SHARED1000 benchmark endpoint.\relax }}{27}{table.caption.17}\protected@file@percent }
\newlabel{tab:final_results}{{5.3}{27}{Final retrieval results on SHARED1000, reported as Recall@1 with and without CSLS hubness correction. The V30/V32 compact--rerank design stage and the V35 plus N1v28a fixed fusion are retained as methodological milestones, while the final exported system is the frozen cross-architecture triple score fusion with weights $0.7/0.1/0.2$ and CSLS neighbourhood size $k=3$. SHARED1000 CSLS Recall@1 is treated as the primary SHARED1000 benchmark endpoint.\relax }{table.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Progression of SHARED1000 CSLS Recall@1 toward the final frozen triple-fusion system. The V35 plus N1v28a fixed fusion is shown as a milestone; the final exported triple fusion of V61a with MC-TTA-16, V62a, and V66a is the highest bar.\relax }}{28}{figure.caption.19}\protected@file@percent }
\newlabel{fig:leaderboard}{{5.2}{28}{Progression of SHARED1000 CSLS Recall@1 toward the final frozen triple-fusion system. The V35 plus N1v28a fixed fusion is shown as a milestone; the final exported triple fusion of V61a with MC-TTA-16, V62a, and V66a is the highest bar.\relax }{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Final exported triple-fusion retrieval architecture. The three independently trained experts (V61a token-space with MC-TTA-16, V62a 768-D CLS, V66a 768-D ROI) each produce a CSLS-corrected retrieval score at frozen neighbourhood size $k=3$. The scores are $z$-score normalised per expert and combined by a frozen weighted sum $w_1/w_2/w_3 = 0.7/0.1/0.2$ to produce the SHARED1000 retrieval ranking (CSLS Recall@1 $= 86.3\%$). The combination operates at the retrieval-score level and is applied only at inference time.\relax }}{29}{figure.caption.21}\protected@file@percent }
\newlabel{fig:triple_fusion_architecture}{{5.3}{29}{Final exported triple-fusion retrieval architecture. The three independently trained experts (V61a token-space with MC-TTA-16, V62a 768-D CLS, V66a 768-D ROI) each produce a CSLS-corrected retrieval score at frozen neighbourhood size $k=3$. The scores are $z$-score normalised per expert and combined by a frozen weighted sum $w_1/w_2/w_3 = 0.7/0.1/0.2$ to produce the SHARED1000 retrieval ranking (CSLS Recall@1 $= 86.3\%$). The combination operates at the retrieval-score level and is applied only at inference time.\relax }{figure.caption.21}{}}
\newlabel{sec:why_triple_fusion_anchor}{{5.4}{29}{Why score-level triple fusion improves retrieval}{section*.22}{}}
\newlabel{subsec:why_triple_fusion}{{5.4}{29}{Why score-level triple fusion improves retrieval}{section*.22}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.4}{\ignorespaces Per-expert SHARED1000 retrieval metrics under the same 1000-image target-embeddings gallery as the primary benchmark endpoint, and the frozen-weight triple-fusion result they produce. Numbers are reproduced verbatim from the exported fusion summary; the gain over the strongest single expert is $+3.2$ percentage points on CSLS Recall@1 and $+1.1$ percentage points on CSLS Recall@5.\relax }}{30}{table.caption.23}\protected@file@percent }
\newlabel{tab:expert_complementarity}{{5.4}{30}{Per-expert SHARED1000 retrieval metrics under the same 1000-image target-embeddings gallery as the primary benchmark endpoint, and the frozen-weight triple-fusion result they produce. Numbers are reproduced verbatim from the exported fusion summary; the gain over the strongest single expert is $+3.2$ percentage points on CSLS Recall@1 and $+1.1$ percentage points on CSLS Recall@5.\relax }{table.caption.23}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.5}{\ignorespaces Final-system implementation summary for the three frozen retrieval experts. All values are reproduced from the YAML configs of V61a, V62a, and V66a in \texttt  {configs/experiments/}. The fusion-time hyperparameters are CSLS neighbourhood size $k=3$, per-expert $z$-score normalisation over the SHARED1000 gallery, and frozen weights $w_1/w_2/w_3 = 0.7/0.1/0.2$ (Equation~\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:triple_fusion_score}\unskip \@@italiccorr )}}).\relax }}{31}{table.caption.24}\protected@file@percent }
\newlabel{tab:hyperparameters}{{5.5}{31}{Final-system implementation summary for the three frozen retrieval experts. All values are reproduced from the YAML configs of V61a, V62a, and V66a in \texttt {configs/experiments/}. The fusion-time hyperparameters are CSLS neighbourhood size $k=3$, per-expert $z$-score normalisation over the SHARED1000 gallery, and frozen weights $w_1/w_2/w_3 = 0.7/0.1/0.2$ (Equation~\eqref {eq:triple_fusion_score}).\relax }{table.caption.24}{}}
